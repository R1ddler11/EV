# --- E.V. backend: server-only secrets. Never use NEXT_PUBLIC_ for these. ---
# OpenRouter API Key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Text model for POST /api/chat via OpenRouter.
# Defaults to anthropic/claude-3.5-sonnet.
# Popular options:
#   anthropic/claude-3.5-sonnet
#   openai/gpt-4o
#   openai/gpt-4o-mini
#   meta-llama/llama-3.3-70b-instruct
#   google/gemini-2.0-flash-exp:free
#   deepseek/deepseek-chat
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Legacy OpenAI key fallback (optional, for backwards compatibility)
OPENAI_API_KEY=

# Voice (Realtime API) model for POST /api/voice/session.
# Verified 2026-10-12 against https://developers.openai.com/api/docs/guides/realtime :
#   gpt-realtime-2.1 (current GA speech-to-speech model)
# Alternative: gpt-realtime-mini (cheaper). Older beta names
# (gpt-4o-realtime-preview-*) are deprecated — do not use.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

OPENAI_REALTIME_VOICE=marin

# Voice works with NO key: POST /api/voice/tts synthesizes free by default
# (Edge Read Aloud TTS primary, Google Translate proxy secondary).
# Optional free-voice default (a Neural voice Name). Blank = en-US-AriaNeural.
#FREE_TTS_VOICE=en-US-AriaNeural

# OPTIONAL premium: Fish Audio TTS (POST /api/voice/tts -> https://api.fish.audio/v1/tts).
# Only used when a key AND a Fish voice reference_id are supplied (request
# body.apiKey/voice, x-fish-* headers, or the env entries below).
# Get a key on your https://fish.audio dashboard.
FISH_AUDIO_API_KEY=

# OPTIONAL premium default voice = a voice model reference_id (NOT a name like
# "nova"). Find model IDs on your fish.audio dashboard under your voices. The
# browser Settings (Voice section) selection overrides this per user.
FISH_AUDIO_VOICE=

# Optional: Fish TTS model header (e.g. s2.1-pro-free for the free developer
# tier). Omit to use the Fish account default.
#FISH_AUDIO_MODEL=

# OPTIONAL: ElevenLabs TTS (free ~10k chars/month @ https://elevenlabs.io).
# Only used when a key + voice_id are supplied (request body elevenKey /
# elevenVoiceId, x-elevenlabs-* headers, or the env entries below).
#ELEVENLABS_API_KEY=
#ELEVENLABS_VOICE_ID=

# OPTIONAL: Azure Speech TTS, free F0 tier (500k chars/month free @
# https://azure.microsoft.com). Same Neural voice pool as the free path.
# Only used when a key + region are supplied (request body azureKey /
# azureRegion, x-azure-* headers, or the env entries below).
#AZURE_SPEECH_KEY=
#AZURE_SPEECH_REGION=

# OPTIONAL: Fish-quality voices via OpenRouter (no Fish key, no Fish credits).
# POST /api/voice/tts routes to the OpenRouter-hosted Fish model below when
# an OpenRouter key + Fish voice id are supplied (request body openRouterKey /
# fishVoiceId, x-openrouter-key / x-fish-voice-id headers, or the env entries
# below) and no Fish-direct / ElevenLabs / Azure path is active.
# Uses ONLY the existing OPENROUTER_API_KEY above — no FISH_AUDIO_API_KEY and
# no Fish Audio credits required. Defaults to the free Fish S2.1 Pro tier.
#OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
